# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uass_dev

# JWT
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

# Cookie
COOKIE_NAME=uass_auth

# Client
CLIENT_URL=http://localhost:5173

# Simulator
SIMULATOR_INTERVAL_MS=3000

# Test DB (used only by test suite)
MONGODB_URI_TEST=mongodb://localhost:27017/uass_test
